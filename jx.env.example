# Jagex account login for the development client.
#
#   copy this file to  jx.env  and fill in the values
#
# jx.env is gitignored on purpose. These are live session values for your own
# account - do not commit them, paste them into chat, or share them.
#
# Only needed to log a Jagex account into the client that `gradlew runClient`
# starts. A legacy account needs none of this, and neither does the plugin once
# it is installed from the Plugin Hub, where the normal launcher handles login.
#
# The Jagex Launcher sets these in the environment of the RuneLite process it
# starts. A client started by Gradle does not inherit them, so they have to be
# provided here instead. They expire, and will need replacing when the dev
# client stops being able to log in.
#
# Blank lines are skipped, so leave anything you do not have empty.

JX_ACCESS_TOKEN=
JX_REFRESH_TOKEN=
JX_SESSION_ID=
JX_CHARACTER_ID=
JX_DISPLAY_NAME=
