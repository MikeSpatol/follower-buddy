{
  "version": 1,
  "comment": "Follower Buddy rules. Edit and save — the plugin reloads within a second. Run ::follower where to print your current region id and coordinates when writing area rules.",
  "rules": [
    {
      "id": "boss-spawn",
      "note": "Fires when a named boss appears in the scene. Add or remove names freely; matching is case-insensitive and supports * wildcards.",
      "group": "boss",
      "priority": 90,
      "cooldownMs": 20000,
      "output": "both",
      "when": {
        "type": "npcSpawn",
        "names": [
          "General Graardor", "K'ril Tsutsaroth", "Commander Zilyana", "Kree'arra",
          "Zulrah", "Vorkath", "Cerberus", "Kraken", "Alchemical Hydra",
          "Great Olm", "Verzik Vitur", "Tekton", "Vasa Nistirio", "Muttadile",
          "TzTok-Jad", "TzKal-Zuk", "Nex", "Corporeal Beast",
          "Callisto", "Venenatis", "Vet'ion", "Scorpia", "Chaos Elemental",
          "Abyssal Sire", "Giant Mole", "Kalphite Queen", "King Black Dragon",
          "Sarachnis", "Zalcano", "Dusk", "Dawn", "Scurrius", "Araxxor",
          "Phantom Muspah", "Duke Sucellus", "The Leviathan", "The Whisperer", "Vardorvis"
        ]
      },
      "say": [
        "{npc} is up. Here we go.",
        "Eyes up — {npc}.",
        "{npc} spawned. Don't embarrass us."
      ]
    },
    {
      "id": "boss-spawn-inferno-wave",
      "note": "Wildcard example: every Inferno NPC name starts with Jal-.",
      "group": "boss",
      "priority": 70,
      "cooldownMs": 30000,
      "when": {
        "type": "npcSpawn",
        "names": ["Jal-*"]
      },
      "say": [
        "Another {npc}. Lovely.",
        "{npc} incoming."
      ]
    },
    {
      "id": "low-hp",
      "note": "Rising-edge: speaks once when you cross under 40%, not every tick you spend there.",
      "group": "health",
      "priority": 100,
      "cooldownMs": 8000,
      "output": "both",
      "when": {
        "type": "healthBelow",
        "percent": 40
      },
      "say": [
        "Eat something! {hp}/{maxHp}.",
        "You're on {hp} HP. Do something about it.",
        "{hpPercent}% health. Tick-eat!"
      ]
    },
    {
      "id": "critical-hp",
      "group": "health",
      "priority": 120,
      "cooldownMs": 5000,
      "output": "both",
      "when": {
        "type": "healthBelow",
        "percent": 20
      },
      "say": [
        "TELEPORT. NOW.",
        "{hp} HP! Get out!"
      ]
    },
    {
      "id": "low-prayer",
      "note": "requirePrayerActive stops this firing when you're just walking around unprayed.",
      "group": "health",
      "priority": 95,
      "cooldownMs": 10000,
      "output": "both",
      "when": {
        "type": "prayerBelow",
        "percent": 20,
        "requirePrayerActive": true
      },
      "say": [
        "Prayer's nearly out — {prayer} points.",
        "Sip a restore, you're on {prayer} prayer."
      ]
    },
    {
      "id": "big-hit-taken",
      "group": "health",
      "priority": 60,
      "cooldownMs": 12000,
      "when": {
        "type": "damageTaken",
        "minimum": 30
      },
      "say": [
        "Ouch. {damage}.",
        "That was a {damage}. Maybe pray next time."
      ]
    },
    {
      "id": "enter-god-wars",
      "note": "EXAMPLE region ids — verify yours with ::follower where before trusting these.",
      "group": "area",
      "priority": 80,
      "cooldownMs": 60000,
      "output": "both",
      "when": {
        "type": "regionEnter",
        "regions": [11347]
      },
      "say": [
        "God Wars. Watch the aggro.",
        "Bring a games necklace, right? ...Right?"
      ]
    },
    {
      "id": "enter-wilderness",
      "group": "area",
      "priority": 110,
      "cooldownMs": 30000,
      "output": "both",
      "when": {
        "type": "varbitEquals",
        "varbit": 5963,
        "value": 1
      },
      "say": [
        "Wilderness. Don't get skulled.",
        "We're in the Wildy. Stay sharp."
      ]
    },
    {
      "id": "enter-dungeon-area",
      "note": "inArea example: a rectangle of world coordinates on a given plane.",
      "group": "area",
      "priority": 50,
      "cooldownMs": 60000,
      "when": {
        "type": "all",
        "conditions": [
          { "type": "inArea", "x1": 2880, "y1": 9800, "x2": 2940, "y2": 9860, "plane": 0 },
          { "type": "healthAbove", "percent": 0 }
        ]
      },
      "say": [
        "Down we go.",
        "Dungeon time."
      ]
    },
    {
      "id": "boss-while-low",
      "note": "Combinator example: only complains if a boss is near AND you're hurt.",
      "group": "boss",
      "priority": 130,
      "cooldownMs": 15000,
      "output": "both",
      "when": {
        "type": "all",
        "conditions": [
          { "type": "healthBelow", "percent": 50 },
          {
            "type": "npcNearby",
            "within": 12,
            "names": ["Great Olm", "Verzik Vitur", "TzKal-Zuk", "Nex", "Vorkath", "Zulrah"]
          }
        ]
      },
      "say": [
        "You are NOT winning this on {hp} HP.",
        "Heal up or leave, {player}."
      ]
    },
    {
      "id": "death",
      "group": "misc",
      "priority": 140,
      "cooldownMs": 5000,
      "output": "both",
      "when": {
        "type": "chatMessage",
        "contains": "Oh dear, you are dead"
      },
      "say": [
        "Well. That happened.",
        "I'll go get the gravestone."
      ]
    },
    {
      "id": "pet-drop",
      "group": "misc",
      "priority": 150,
      "cooldownMs": 1000,
      "output": "both",
      "when": {
        "type": "chatMessage",
        "contains": "funny feeling like"
      },
      "say": [
        "PET! Actual pet!",
        "You lucky thing."
      ]
    },
    {
      "id": "level-up",
      "group": "misc",
      "priority": 40,
      "cooldownMs": 3000,
      "when": {
        "type": "levelUp",
        "names": ["*"]
      },
      "say": [
        "{skill} {level}. Nice.",
        "Level {level} {skill}!"
      ]
    },
    {
      "id": "login-greeting",
      "note": "A hello a couple of seconds after the follower teleports in on login. Spawn happens ~4 ticks after login; delayTicks 8 lands the line ~2.5s after the puff. The cooldown stops quick world hops re-greeting.",
      "group": "misc",
      "priority": 90,
      "output": "overhead",
      "delayTicks": 8,
      "cooldownMs": 60000,
      "when": { "type": "login" },
      "say": [
        "There you are! Right on schedule.",
        "Welcome back, {player}. I kept your spot warm.",
        "Ah, you made it! Gielinor was getting quiet without you.",
        "Back again? Excellent. Where to today?"
      ]
    },
    {
      "id": "gear-staves",
      "note": "Equip reactions fire once per equip (rising edge). Ids: battlestaff, lava battlestaff, air/water/earth/fire staves.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [1391, 3053, 1381, 1383, 1385, 1387] },
      "say": ["Runes at the ready, then. Try not to singe my outfit."]
    },
    {
      "id": "gear-dfs",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [11283] },
      "say": ["Is that dragon breath swirling in there? Keep it pointed away from me."]
    },
    {
      "id": "gear-rogue",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [5553, 5555, 5556, 5557] },
      "say": ["Dressed for crime, I see. I saw nothing."]
    },
    {
      "id": "gear-dodgy-necklace",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [21143] },
      "say": ["A dodgy necklace? Sensible, in your line of work."]
    },
    {
      "id": "gear-dragon-dagger",
      "note": "Dragon dagger, incl. poisoned and arena variants.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [1215, 1231, 5680, 5698, 20407, 28019, 28021, 28023, 28025] },
      "say": [
        "The dragon dagger. Four pokes, no waiting.",
        "Ah, the classic. Stab twice, ask questions never.",
        "Poisoned? Charming. Keep it pointed that way."
      ]
    },
    {
      "id": "gear-granite-maul",
      "note": "Granite maul, all variants.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [4153, 12848, 20557, 24225, 24227] },
      "say": [
        "The granite maul. No warning, just bonk.",
        "Subtlety's overrated anyway."
      ]
    },
    {
      "id": "gear-dragon-warhammer",
      "note": "Dragon warhammer, incl. ornament variants.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [13576, 20785, 26710, 28035] },
      "say": [
        "One good smack and their armour turns to paper.",
        "Please land it. For morale."
      ]
    },
    {
      "id": "gear-elder-maul",
      "note": "Elder maul, incl. ornament variant.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [21003, 21205, 27100] },
      "say": [
        "That's not a weapon, that's a landmark.",
        "Lift with the knees. Both of them."
      ]
    },
    {
      "id": "gear-godsword",
      "note": "Any godsword: Armadyl, Bandos, Saradomin, Zamorak, Ancient, incl. ornament variants.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [11802, 11804, 11806, 11808, 20368, 20370, 20372, 20374, 20593, 22665, 26233, 27184, 28537, 29605] },
      "say": [
        "A godsword. Do warn me before you swing.",
        "That blade is taller than I am.",
        "The gods made that. Respect it — from a distance."
      ]
    },
    {
      "id": "gear-dragon-claws",
      "note": "Dragon claws, incl. ornament variants.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [13652, 20784, 26708, 28039] },
      "say": [
        "Dragon claws. Four hits, zero mercy.",
        "Scratch first, apologise never."
      ]
    },
    {
      "id": "gear-abyssal-tentacle",
      "note": "Abyssal tentacle, incl. ornament variant.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [12006, 26484] },
      "say": [
        "A whip with a squid on it. Why not.",
        "It's wriggling. It's WRIGGLING."
      ]
    },
    {
      "id": "gear-toxic-blowpipe",
      "note": "Toxic blowpipe, charged or empty.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [12924, 12926] },
      "say": [
        "Darts and venom. Horribly efficient.",
        "Just don't inhale."
      ]
    },
    {
      "id": "gear-twisted-bow",
      "note": "Twisted bow.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [20997] },
      "say": [
        "THE bow. We're dangerous AND rich.",
        "Careful where you lean that. It costs more than a castle."
      ]
    },
    {
      "id": "gear-bofa",
      "note": "Bow of faerdhinen, incl. corrupted and recolours.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [25862, 25865, 25867, 25884, 25886, 25888, 25890, 25892, 25894, 25896, 27187, 33021] },
      "say": [
        "Crystal song in every draw. Fancy.",
        "Elven craftsmanship. We're posh now."
      ]
    },
    {
      "id": "gear-scythe",
      "note": "Scythe of vitur, incl. holy and sanguine variants.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [22325, 22486, 22664, 25736, 25738, 25739, 25741, 28543, 28545] },
      "say": [
        "Mind the arc — I walk behind you, remember.",
        "A vampyre's scythe. Sweep them all at once."
      ]
    },
    {
      "id": "gear-ghrazi-rapier",
      "note": "Ghrazi rapier, incl. holy variant.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [22324, 23628, 25734] },
      "say": [
        "The pointy end goes very fast. Understood.",
        "Elegant. Deadly. Slightly showy."
      ]
    },
    {
      "id": "gear-osmumtens-fang",
      "note": "Osmumten's fang, incl. ornament variant.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [26219, 27246, 33174] },
      "say": [
        "The fang rarely misses. The pharaohs knew things.",
        "A pyramid's worth of history on your belt."
      ]
    },
    {
      "id": "gear-voidwaker",
      "note": "Voidwaker.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [27690, 27869, 29607] },
      "say": [
        "That glow isn't friendly. Neither are you, apparently.",
        "Three Wilderness bosses gave up pieces for that. Poetic."
      ]
    },
    {
      "id": "gear-rune-crossbow",
      "note": "Rune crossbow, incl. ornament variant.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [9185, 23601, 26486] },
      "say": [
        "Old reliable clicks again.",
        "Load, loose, repeat. The classics endure."
      ]
    },
    {
      "id": "gear-magic-shortbow",
      "note": "Magic shortbow and imbued version.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [861, 12788, 20558] },
      "say": [
        "Bends like a reed, bites like a wolf.",
        "Twang twang twang. Music to my ears."
      ]
    },
    {
      "id": "gear-trident",
      "note": "Tridents of the seas and swamp, all variants.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [11905, 11907, 12899, 22288, 22292, 33314, 33318, 33322, 33323, 33326] },
      "say": [
        "A staff that casts itself. Lazy. Effective.",
        "The kraken parted with that grudgingly, I'd wager."
      ]
    },
    {
      "id": "gear-tumekens-shadow",
      "note": "Tumeken's shadow.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [27275, 27277] },
      "say": [
        "A staff of pure shadow. Kindly don't point it at me.",
        "It hums with the sun god's power. Ominous. Expensive."
      ]
    },
    {
      "id": "gear-dinhs-bulwark",
      "note": "Dinh's bulwark.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [21015] },
      "say": [
        "Is there room behind that for both of us?",
        "A door with ambitions."
      ]
    },
    {
      "id": "gear-bandos-armour",
      "note": "Bandos chestplate or tassets, incl. ornament variants.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [11832, 11834, 23646, 26718, 26719] },
      "say": [
        "Bandos armour. You could stop a battering ram in that.",
        "The Big High War God's finest plate."
      ]
    },
    {
      "id": "gear-armadyl-armour",
      "note": "Armadyl chestplate or chainskirt, incl. ornament variants.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [11828, 11830, 26715, 26716] },
      "say": [
        "Feathered and fierce. Kree'arra's tailor does good work.",
        "Light as a feather. Costs like a mansion."
      ]
    },
    {
      "id": "gear-ancestral",
      "note": "Any ancestral piece: hat, robe top, robe bottom.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [21018, 21021, 21024, 25518, 27193, 27194] },
      "say": [
        "Those robes hum with old magic.",
        "Very stylish. Very purple. Very expensive."
      ]
    },
    {
      "id": "gear-justiciar",
      "note": "Any justiciar piece: faceguard, chestguard, legguards.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [22326, 22327, 22328] },
      "say": [
        "Justiciar plate. You look like the law itself.",
        "They'll need a bigger weapon."
      ]
    },
    {
      "id": "gear-black-dhide",
      "note": "Black d'hide body or chaps, incl. trimmed variants.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [2497, 2503, 12381, 12383, 12385, 12387, 20423, 20424, 25493] },
      "say": [
        "Dragonhide. Practical AND menacing.",
        "Some dragon is very cold right now."
      ]
    },
    {
      "id": "gear-fighter-torso",
      "note": "Fighter torso, incl. ornament variants.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [10551, 24175, 28067, 28069] },
      "say": [
        "The torso! Penance-earned and proud.",
        "Blood, sweat and Barbarian Assault."
      ]
    },
    {
      "id": "gear-barrows-gloves",
      "note": "Barrows gloves.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [7462, 23593, 27112] },
      "say": [
        "Barrows gloves. The Culinaromancer sends his regards.",
        "The finest gloves in Gielinor, earned one rescued feast at a time."
      ]
    },
    {
      "id": "gear-dragon-defender",
      "note": "Dragon defender, incl. trimmed variants.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [12954, 19722, 23597, 24143, 27008] },
      "say": [
        "Attack and defence in one fist. Cyclops-approved.",
        "How many cyclopes was it, in the end?"
      ]
    },
    {
      "id": "gear-avernic-defender",
      "note": "Avernic defender.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [22322, 24186] },
      "say": [
        "An avernic defender. The cyclopes could never.",
        "Forged in the Theatre. Fancy."
      ]
    },
    {
      "id": "gear-crystal-armour",
      "note": "Crystal helm, body or legs, incl. recolours. Gauntlet versions excluded.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [23971, 23973, 23975, 23977, 23979, 23981, 27697, 27699, 27701, 27703, 27705, 27707, 27709, 27711, 27713, 27715, 27717, 27719, 27721, 27723, 27725, 27727, 27729, 27731, 27733, 27735, 27737, 27739, 27741, 27743, 27745, 27747, 27749, 27751, 27753, 27755, 27757, 27759, 27761, 27763, 27765, 27767, 27769, 27771, 27773, 27775, 27777, 27779, 33023, 33025, 33027, 33029, 33031, 33033, 33166, 33168, 33170] },
      "say": [
        "Crystal armour. You chime when you walk now.",
        "Elegant. Just don't drop it."
      ]
    },
    {
      "id": "gear-cerberus-boots",
      "note": "Primordial, pegasian or eternal boots.",
      "group": "gear",
      "priority": 30,
      "output": "overhead",
      "delayTicks": 2,
      "cooldownMs": 5000,
      "when": { "type": "itemEquipped", "ids": [13235, 13237, 13239, 23644] },
